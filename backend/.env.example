# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# Local fallback: mongodb://localhost:27017/gmp_vision
# Atlas production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gmp_vision?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gmp_vision

# ── JWT Authentication ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS Allowlist ───────────────────────────────────────────────────────
# Comma-separated client URLs allowed to send cross-origin requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Cloudinary Media Management ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email Notifications (SMTP via Nodemailer / Resend) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gmpvision3@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@gmpvision.com
ADMIN_NOTIFICATION_EMAIL=gmpvision3@gmail.com

# ── Superadmin Initial Provisioning Seed ─────────────────────────────────
SUPERADMIN_EMAIL=admin@gmpvision.com
SUPERADMIN_PASSWORD=Admin@GMPVision2026!
